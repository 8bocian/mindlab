# Konfiguracja MindLab. Skopiuj ten plik jako lab.env i uzupełnij.
# lab.env zawiera klucz API - nie udostępniaj go nikomu.

# --- Hyperstack ---
HYPERSTACK_API_KEY=wklej-tutaj-klucz-api
# Environment = "folder" na zasoby w danym regionie, tworzony w panelu Hyperstack.
# Listę zobaczysz po: python lab.py check
ENVIRONMENT=default-CANADA-1
# Nazwa klucza SSH w Hyperstacku. Jeśli go tam nie ma, lab.py sam zaimportuje SSH_PUBLIC_KEY pod tą nazwą.
KEYPAIR_NAME=mindlab-key
SSH_PRIVATE_KEY=~/.ssh/id_ed25519
SSH_PUBLIC_KEY=~/.ssh/id_ed25519.pub
SSH_USER=ubuntu
# Kto może się łączyć przez SSH. 0.0.0.0/0 = każdy (i tak potrzebny jest klucz).
# Bezpieczniej: tylko Twoje IP, np. 83.12.34.56/32
SSH_ALLOW_CIDR=0.0.0.0/0

# GPU: fragment nazwy GPU (spacje i myślniki są ignorowane) i liczba kart
GPU_MATCH=RTXPRO6000
GPU_COUNT=1
# Karty do wypróbowania po kolei, gdy pierwsza jest niedostępna (bez wersji spot).
# Zahibernowanej VM nie da się przenieść na inną kartę: lab.py start tworzy wtedy nową VM
# (pełna instalacja ok. 10-15 min), a starą usuwa, gdy nowa już działa (DELETE_OLD_ON_FALLBACK=1).
GPU_FALLBACK=A100,L40,H100
DELETE_OLD_ON_FALLBACK=1
# Opcjonalnie dokładne nazwy (inaczej wybór automatyczny - podgląd: python lab.py check)
FLAVOR_NAME=
IMAGE_NAME=
IMAGE_PREFER=24.04
VM_NAME=mindlab
# Tylko do szacowania kosztu w terminalu (USD/h)
PRICE_PER_HOUR=1.85

# --- Co zrobić po Ctrl+C albo gdy zadziała strażnik: hibernate | delete | keep ---
#   hibernate = płacisz tylko za dysk (~$0,07/GB/mies.), następny start szybki
#   delete    = nic nie płacisz, następny start od zera (instalacja + pobranie modelu)
END_ACTION=hibernate
# Strażnik na VM (chroni, gdy laptop zaśnie lub stracisz internet): 1 = włączony
WATCHDOG=1
IDLE_MINUTES=180
MAX_HOURS=0   # 0 = bez limitu łącznego czasu (tylko bezczynność)

# --- Model ---
# Zacznij od modelu, który na pewno działa, potem przełącz na Inklinga:
MODEL=Qwen/Qwen3-8B
# MODEL=thinkingmachines/Inkling-2-Mini
DTYPE=auto
TRUST_REMOTE_CODE=0
# Dla modeli z ograniczonym dostępem (Llama, Gemma…) wklej token Hugging Face:
HF_TOKEN=
# Ręczne wskazanie warstw/normalizacji, gdy autodetekcja zawiedzie, np. model.language_model.layers
LAYERS_PATH=
NORM_PATH=
# Pojęcia liczone przy starcie (po angielsku działają zwykle mocniej)
DEFAULT_CONCEPTS=ocean,dogs,fear,Poland
# Dodatkowe pakiety pip na VM, np. "transformers==5.30.0" albo adres git
EXTRA_PIP=

# --- Po Twojej stronie ---
LOCAL_PORT=8000

# --- Tryb publiczny: frontend na Vercelu, backend przez Cloudflare Tunnel (README, sekcja 6) ---
# Token tunelu z panelu Cloudflare (Zero Trust → Networks → Tunnels). Pusty = tylko tryb lokalny.
CLOUDFLARE_TUNNEL_TOKEN=
# Hasło, które podajesz znajomym (min. 10 znaków). Wymagane, gdy ustawiony jest token tunelu.
ACCESS_PASSWORD=
# Adres frontendu na Vercelu (CORS), np. https://mindlab.vercel.app. Kilka adresów: po przecinku.
ALLOWED_ORIGINS=*
# Otwierany w przeglądarce po: python lab.py start
PUBLIC_URL=
# Limit długości jednej odpowiedzi, żeby nikt nie blokował kolejki na długo
MAX_NEW_TOKENS_CAP=400
